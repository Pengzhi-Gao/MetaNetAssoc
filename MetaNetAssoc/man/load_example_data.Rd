\name{load_example_data}
\alias{load_example_data}
\title{Load Biologically Plausible Synthetic Example Data}
\usage{load_example_data(path = NULL)}
\arguments{
\item{path}{Optional path to an \code{extdata} directory. Normally omitted.}
}
\value{A named list containing candidate metabolites, focus genes, MPI, PPI,
and enrichment tables.}
\description{
Loads a deterministic germ-cell multi-omics tutorial dataset. All associations
and scores are synthetic and must not be interpreted as curated evidence.
}

